{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "artix_small", // Options: "artix", "artix_small", "arch", "linux", etc.
    "width": 38,
    "height": 16,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "cyan",
      "title": "bright_cyan"
    },
    "key": {
      "width": 13,
      "type": "icon"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "format": "{3}"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel"
    },
    {
      "type": "initsystem",
      "key": "󰌗 Init"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    "break",
    {
      "type": "shell",
      "key": "󰞷 Shell"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    {
      "type": "de",
      "key": "󰧨 Desktop"
    },
    {
      "type": "wm",
      "key": "󱂬 Window Mgr"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "format": "{used} / {total} ({percentage})"
    },
    "break",
    "colors"
  ]
}
